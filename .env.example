# ══════════════════════════════════════════════════════════════
# VolBot Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ─── Network ─────────────────────────────────────────────────
# RPC endpoint for Solana (devnet or mainnet)
RPC_ENDPOINT=https://api.devnet.solana.com
# For mainnet: https://mainnet.infura.io/v3/YOUR_KEY
# Or use Helius/QuickNode/Alch for better reliability

# ─── Wallet ──────────────────────────────────────────────────
# Main wallet private key (base58 encoded, comma-separated for Phantom-style)
# Generate test wallets with: ./run.sh --term  (interactive key generation)
PRIVATE_KEY=

# ─── Telegram Bot (Optional) ─────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Jupiter API (for swaps) ─────────────────────────────────
JUPITER_API_KEY=

# ─── Helius API (for enhanced RPC) ───────────────────────────
HELIUS_API_KEY=

# ─── Defaults ────────────────────────────────────────────────
# These can also be overridden per-run via CLI arguments
DEFAULT_BUDGET_USD=6
DEFAULT_WALLETS=5
DEFAULT_TRADE_MINUTES=5
DEFAULT_SLIPPAGE=1.0
